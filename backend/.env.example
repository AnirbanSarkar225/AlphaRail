# ==============================================================================
# AlphaRail Backend Configuration
# ==============================================================================

# Database Connection URL (Defaults to local async SQLite for development)
# For production PostgreSQL, use: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./alpharail_dev.db

# Optional: OpenWeatherMap API Key for live weather impact calculations
# Get a free key at https://openweathermap.org/api
OPENWEATHER_KEY=your_openweathermap_api_key_here

# Optional: RapidAPI Key for live Indian Railways schedule lookups
RAPIDAPI_KEY=your_rapidapi_key_here
